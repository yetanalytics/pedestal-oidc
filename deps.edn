{:paths ["src/lib" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.11.4"}
        io.pedestal/pedestal.service {:mvn/version "0.6.3"}
        buddy/buddy-sign {:mvn/version "3.5.351"}
        org.clojure/tools.logging {:mvn/version "1.2.4"}
        cheshire/cheshire {:mvn/version "5.12.0"}
        ;; Keep Buddy's cryptography and Cheshire's JSON dependencies patched.
        org.bouncycastle/bcprov-jdk18on {:mvn/version "1.85"}
        org.bouncycastle/bcpkix-jdk18on {:mvn/version "1.85"}
        org.bouncycastle/bcutil-jdk18on {:mvn/version "1.85"}
        com.fasterxml.jackson.core/jackson-core {:mvn/version "2.18.11"}
        com.fasterxml.jackson.dataformat/jackson-dataformat-smile {:mvn/version "2.18.11"}
        com.fasterxml.jackson.dataformat/jackson-dataformat-cbor {:mvn/version "2.18.11"}
        commons-fileupload/commons-fileupload {:mvn/version "1.6.0"}
        commons-io/commons-io {:mvn/version "2.21.0"}
        org.clojure/core.async {:mvn/version "1.5.648"}}
 :aliases
 {:dev {:extra-paths ["src/dev"]
        :extra-deps {io.pedestal/pedestal.jetty {:mvn/version "0.6.3"}
                     ch.qos.logback/logback-classic
                     {:mvn/version "1.2.9"
                      :exclusions [org.slf4j/slf4j-api]}}}
  :run
  {:ns-default com.yetanalytics.pedestal-oidc.server
   :exec-fn run-dev}
  :test {:extra-paths ["src/test"]
         :extra-deps {org.clojure/test.check {:mvn/version "1.1.0"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.0" :git/sha "48c3c67"}}
         :exec-fn cognitect.test-runner.api/test
         :exec-args
         {:dirs ["src/test"]}}}}
